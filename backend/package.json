{
  "name": "zydock-backend",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "start": "bun run index.ts",
    "seed": "bun run src/seeds/index.ts",
    "validate:catalog": "bun run src/scripts/validate-catalog.ts",
    "fix:non-http-auto-domains": "bun run src/scripts/remove-non-http-auto-domains.ts",
    "migrate:superuser-marker": "bun run src/scripts/migrate-superuser-marker.ts",
    "bootstrap:code": "bun run src/scripts/bootstrap-code.ts",
    "build": "bun build index.ts --compile --outfile server",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prettier": "prettier ./ --check",
    "prettier:fix": "prettier ./ --write",
    "lint": "bun run prettier && bun run typecheck",
    "fix": "bun run prettier:fix && bun run typecheck && bun outdated"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.11.9",
    "bson": "^6.10.4",
    "hono": "^4.12.28",
    "hono-route-docs": "^1.0.1",
    "mongoose": "^8.24.1",
    "nodemailer": "^9.0.3",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "^1.15.5",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
