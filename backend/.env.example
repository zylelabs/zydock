PORT="8000"
SERVER_IDLE_TIMEOUT_SECONDS="120"

MODE="dev"

ZYDOCK_VERSION=""
ZYDOCK_COMMIT=""
ZYDOCK_CHANNEL=""

ZYDOCK_REPOSITORY="zylelabs/zydock"

PANEL_NAME="Zydock"

LOG_LEVEL="info"

CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

MONGO_URI=""

JWT_SECRET=""
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_DAYS="30"

PASSWORD_RESET_TTL_MINUTES="30"

RATE_LIMIT_SIGNIN_WINDOW_MS="900000"
RATE_LIMIT_SIGNIN_MAX="10"
RATE_LIMIT_SIGNUP_WINDOW_MS="3600000"
RATE_LIMIT_SIGNUP_MAX="10"
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS="900000"
RATE_LIMIT_FORGOT_PASSWORD_MAX="5"
RATE_LIMIT_RESET_PASSWORD_WINDOW_MS="900000"
RATE_LIMIT_RESET_PASSWORD_MAX="10"
RATE_LIMIT_REFRESH_WINDOW_MS="900000"
RATE_LIMIT_REFRESH_MAX="30"
RATE_LIMIT_INVITE_ACCEPT_WINDOW_MS="900000"
RATE_LIMIT_INVITE_ACCEPT_MAX="10"
RATE_LIMIT_BOOTSTRAP_SIGNUP_WINDOW_MS="900000"
RATE_LIMIT_BOOTSTRAP_SIGNUP_MAX="5"

# 32 bytes in hex — generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

AGENT_PORT="9000"
AGENT_TIMEOUT_MS="15000"
AGENT_OFFLINE_AFTER_SECONDS="90"
AGENT_BUNDLE_PATH="../agent/dist/agent.js"

TEMPLATES_CATALOG_PATH="../templates"
TEMPLATE_SOURCES_CACHE_PATH="../template-sources-cache"
TEMPLATE_SOURCES_CLONE_TIMEOUT_MS="30000"

LOCAL_AGENT_TOKEN=""
LOCAL_SERVER_NAME="Local"
LOCAL_AGENT_HOST="agent"
LOCAL_AGENT_PORT="9000"
PUBLIC_IP=""

DEFAULT_ORGANIZATION_NAME="My organization"

CONTAINER_RUNTIME="docker"
REVERSE_PROXY="caddy"
STORAGE_PROVIDER="local"
DNS_PROVIDER="cloudflare"
GIT_DEFAULT_HOST="github"
SSH_PROVIDER="ssh2"
TLS_PROVIDER="openssl"
BACKEND_URL="http://localhost:8000"

STORAGE_LOCAL_PATH="./storage"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Zydock <no-reply@localhost>"

QUEUE_ENABLED="true"
QUEUE_POLL_INTERVAL_MS="1000"
QUEUE_CONCURRENCY="2"
QUEUE_MAX_ATTEMPTS="3"
QUEUE_RETRY_DELAY_MS="5000"
QUEUE_JOB_TIMEOUT_SECONDS="1800"

DEPLOY_WORKSPACE_PATH="/var/lib/zydock/builds"
DEPLOY_HEALTHCHECK_TIMEOUT_SECONDS="180"
DEPLOY_HEALTHCHECK_MAX_SECONDS="3600"
DEPLOY_LOG_LINES="500"

LOGS_STREAM_TAIL="100"

PROXY_NETWORK="zydock"
PROXY_ACCESS_RETENTION_HOURS="168"

AUTO_DOMAIN_ENABLED="true"
AUTO_DOMAIN_SUFFIX="backname.io"

COMPOSE_REGISTRY_ALLOWLIST="docker.io,ghcr.io,quay.io"
COMPOSE_MAX_SERVICES="10"
COMPOSE_DEFAULT_MEMORY_LIMIT_MB="512"

REGISTRY_TAGS_ENABLED="true"
REGISTRY_TAGS_TTL_HOURS="6"
REGISTRY_TAGS_TIMEOUT_MS="5000"

METRICS_RETENTION_HOURS="168"
METRICS_STREAM_INTERVAL_SECONDS="5"

DATABASE_METRICS_ENABLED="true"
DATABASE_METRICS_SAMPLE_INTERVAL_MINUTES="5"
DATABASE_METRICS_RETENTION_HOURS="48"
DATABASE_METRICS_PEAK_WINDOW_HOURS="24"

NOTIFICATIONS_RETENTION_HOURS="720"
