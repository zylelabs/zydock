# .dockerignore

# Ignore node_modules directory
node_modules

# Ignore log files
*.log

# Ignore Docker-related files
Dockerfile
docker-compose.yml

# Ignore build directories
dist
build

# Ignore Nuxt build/runtime output
.nuxt
.output
.data
.nitro

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
.vscode
.idea
.github

# Ignore other unnecessary files
*.swp
*.swo

# Ignore development files
tests
docs
*.spec.*
*.test.*
*.e2e.*
.markdownlint.json
.prettierignore
.prettierrc
.eslintrc
.eslintignore
.editorconfig
.gitignore
.gitattributes
.npmrc
.nvmrc
*.md

# Ignore local secrets
.env
.env.*
