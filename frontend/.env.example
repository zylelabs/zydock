# URL do backend, conhecida apenas pelo servidor Nitro — o navegador fala com /api/proxy.
# O prefixo NUXT_ é o que permite trocá-la em runtime, sem novo build.
NUXT_URL_API="http://127.0.0.1:8000"

# URL do WebSocket do backend: a única que chega ao navegador, porque o proxy só trafega JSON
NUXT_PUBLIC_WS_URL="ws://127.0.0.1:8000/api/ws"
