{
  "id": "uptime-kuma",
  "version": 4,
  "name": "Uptime Kuma",
  "tagline": "Self-hosted monitoring tool with a slick status page",
  "category": "monitoring",
  "tags": ["monitoring", "status-page"],
  "website": "https://github.com/louislam/uptime-kuma",
  "documentation": "https://github.com/louislam/uptime-kuma/wiki",
  "license": "MIT",
  "author": "zydock",
  "origin": "official",
  "docker_compose": "docker-compose.yml",
  "expose": { "service": "app", "port": 3001, "domain": true },
  "databases": [],
  "inputs": [],
  "secrets": [],
  "versions": {
    "key": "VERSION",
    "default": "2",
    "available": [
      { "value": "2", "label": "2.x (stable)" },
      { "value": "1", "label": "1.x (legacy)" }
    ],
    "registry": {
      "include": "^v?\\d+(\\.\\d+){0,2}$",
      "limit": 50
    }
  }
}
